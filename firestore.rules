rules_version = '2';

// Simple Firebase rules for Onnodhara e-commerce store
// Collections: products, orders, settings
// Note: This app uses client-side admin login, not Firebase Auth.
// For production, consider adding Firebase Authentication.

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow all reads/writes for now since auth is handled client-side
    match /products/{productId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    // Default deny for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
